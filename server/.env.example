PORT=3000
MONGODB_URI=mongodb://localhost:27017/portfolio

# Password for the /admin pages
ADMIN_PASSWORD=change-me
# Long random string used to sign login sessions. Changing it logs everyone out.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Only needed when the site and API are on different domains (e.g. on Render)
CORS_ORIGIN=
